# Solace Distributed Tracing Observatory — configuration
# cp .env.example .env

# BROKER — host.docker.internal reaches a broker on this machine, from
# containers and your terminal alike. Point at your own broker instead if
# you're not using docker-compose.broker.yaml.
SOLACE_BROKER_HOST=host.docker.internal
SOLACE_BROKER_AMQP_PORT=5672
SOLACE_SEMP_URL=http://host.docker.internal:8080

# MESSAGE VPN — the VPN that gets traced; the bootstrap script creates it
# and moves AMQP onto it.
SOLACE_MSG_VPN=test
SOLACE_VPN_SPOOL_MB=1500

# CREDENTIALS — change before any non-local use
SOLACE_ADMIN_USER=admin
SOLACE_ADMIN_PASSWORD=admin

# Collector's identity on the telemetry queue
SOLACE_TRACE_USER=trace_user
SOLACE_TRACE_PASSWORD=trace_user_pw

# Ordinary app user for sdkperf / your own clients
SOLACE_APP_USER=dtuser
SOLACE_APP_PASSWORD=dtuser_pw

# Grafana login — fixed in Grafana's DB on first boot, see README to change later
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# BROKER BOOTSTRAP — read by scripts/setup-broker-tracing.sh
BOOTSTRAP_ENABLED=true
TELEMETRY_PROFILE_NAME=trace
TRACE_FILTER_SUBSCRIPTION=">"
TELEMETRY_QUEUE_SPOOL_MB=500

# OTEL COLLECTOR
SOLACE_TELEMETRY_QUEUE="queue://#telemetry-trace"
SOLACE_MAX_UNACKNOWLEDGED=500
OTEL_MEMORY_LIMIT_MIB=1000
OTEL_MEMORY_SPIKE_MIB=500
OTEL_BATCH_SIZE=8192
OTEL_BATCH_TIMEOUT=5s
OTEL_LOG_LEVEL=info
OTEL_DEBUG_VERBOSITY=normal

# JSONL TRACE SINK — off by default; see README for docker-compose.jsonl.yaml
TRACE_FILE_ENABLED=false
TRACE_FILE_MAX_MB=50
TRACE_FILE_MAX_DAYS=90
TRACE_FILE_MAX_BACKUPS=100
COLLECTOR_UID=0
COLLECTOR_GID=0

# TEMPO
TEMPO_RETENTION=336h
VERIFY_LOOKBACK_HOURS=168

# HOST PORTS — change if something already owns one
PORT_BROKER_SEMP=8080
PORT_BROKER_SMF=55555
PORT_BROKER_AMQP=5672
PORT_BROKER_HEALTH=5550
PORT_BROKER_SSH=2222
PORT_BROKER_WEB=8008
PORT_GRAFANA=3000
PORT_TEMPO=3200
PORT_OTLP_GRPC=4317
PORT_OTLP_HTTP=4318
PORT_OTEL_HEALTH=13133
PORT_OTEL_METRICS=8888
PORT_OTEL_ZPAGES=55679

# IMAGE TAGS — pinned deliberately, never :latest
SOLACE_IMAGE=solace/solace-pubsub-standard:10.26.0.8704
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.144.0
TEMPO_IMAGE=grafana/tempo:2.8.2
GRAFANA_IMAGE=grafana/grafana:13.1.1
