# =============================================================================
# Solace Broker Metrics — configuration
#
# Copy to .env and edit. Every knob in the stack lives here; nothing is
# hardcoded in the YAML files (except Prometheus scrape intervals — Prometheus's
# config format has no env-substitution, so those live in
# config/prometheus/prometheus.yml directly).
#
#   cp .env.example .env
# =============================================================================


# =============================================================================
# BROKER MODE — local container, or your own broker
# =============================================================================
# local    = run a Solace broker as part of this stack (self-contained demo)
# external = use a broker you already have
BROKER_MODE=local

# local mode:    leave this as-is. `solbroker` is the container's network name.
# external mode: point it at your broker, reachable FROM INSIDE the docker
#                network (not "localhost" — that resolves to the container itself).
SOLACE_SEMP_URL=http://solbroker:8080

# Same broker as reached from your host machine. Used by stack.sh verify and by
# broker-setup.sh when run by hand from a terminal.
SOLACE_SEMP_HOST_URL=http://localhost:8080


# =============================================================================
# MESSAGE VPN
# =============================================================================
# Same VPN name as the grafana-dt (tracing) branch, by convention — nothing here
# depends on it matching, but consistency avoids confusion when branches merge.
SOLACE_MSG_VPN=test
SOLACE_VPN_SPOOL_MB=1500


# =============================================================================
# CREDENTIALS — change these before any non-local use
# =============================================================================
# Broker admin (SEMP config API). In local mode these also CREATE the admin
# user on first boot.
SOLACE_ADMIN_USER=admin
SOLACE_ADMIN_PASSWORD=admin

# Read-only SEMP user dedicated to the Prometheus exporter. Created directly on
# the broker via `username_monitor_*` env vars (a broker-level identity, not a
# VPN-scoped client username — Solace's docker image treats any
# `username_<name>_<attr>` env var as a CLI config command at first boot,
# already used above for `admin`). The exporter never gets admin credentials.
# Username is fixed as "monitor" — changing it means editing docker-compose.yaml
# too, so it is not itself a variable.
SOLACE_MONITOR_PASSWORD=monitor_pw

# An ordinary application user, so sdkperf / your own clients can publish to the
# demo queue's topic and generate traffic for the dashboard.
SOLACE_APP_USER=appuser
SOLACE_APP_PASSWORD=appuser_pw

# Grafana login.
#
# GOTCHA: with a persistent volume this password is written to Grafana's SQLite
# database on FIRST BOOT and ignored on every start after that. Changing it here
# later does nothing. Reset it with `stack.sh reset`, or through Grafana itself.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin


# =============================================================================
# BROKER BOOTSTRAP
# =============================================================================
# false = skip broker configuration entirely. Use this in external mode when you
#         don't have admin on the broker, or it's already configured.
BOOTSTRAP_ENABLED=true

# A demo queue + topic subscription, created so queue-level dashboard panels
# have real data without you having to create one by hand first.
SOLACE_DEMO_QUEUE=demo-queue
SOLACE_DEMO_TOPIC=metrics/demo
SOLACE_DEMO_QUEUE_SPOOL_MB=500


# =============================================================================
# PROMETHEUS EXPORTER (solacecommunity/solace-prometheus-exporter)
# =============================================================================
# The exporter's own listen address is fixed at 0.0.0.0:9628 inside the
# container (its default); PORT_EXPORTER below only controls the host mapping.


# =============================================================================
# PROMETHEUS RETENTION
# =============================================================================
# Bounded two ways: time AND size. Time-based retention alone can still fill
# disk under a scrape-rate spike, so capping both is the production-appropriate
# default even at this scale.
METRICS_RETENTION_TIME=7d
METRICS_RETENTION_SIZE=2GB


# =============================================================================
# HOST PORTS — change if something already owns one
# =============================================================================
PORT_BROKER_SEMP=8080       # Broker web UI + SEMP API
PORT_BROKER_SMF=55555       # SMF — sdkperf connects here
PORT_BROKER_HEALTH=5550     # Health check
PORT_BROKER_SSH=2222        # Broker CLI over SSH
PORT_BROKER_WEB=8008        # Web messaging
PORT_EXPORTER=9628          # Prometheus exporter
PORT_PROMETHEUS=9090        # Prometheus UI/API
PORT_GRAFANA=3000           # Grafana UI


# =============================================================================
# IMAGE TAGS — pinned deliberately, never :latest
# =============================================================================
SOLACE_IMAGE=solace/solace-pubsub-standard:10.26.0.8704
EXPORTER_IMAGE=solacecommunity/solace-prometheus-exporter:v1.20.2
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
GRAFANA_IMAGE=grafana/grafana:13.1.1
CURL_IMAGE=curlimages/curl:8.11.1
