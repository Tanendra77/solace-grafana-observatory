# Solace Broker Metrics — configuration
# Copy to .env and edit.
#
#   cp .env.example .env
#   ./scripts/generate-certs.sh        # needed once, before first `up`


# BROKER
# host.docker.internal works both from inside containers and from your
# terminal (confirmed on Docker Desktop), so one URL covers both.
# Using docker-compose.broker.yaml: leave as-is, then run
# ./scripts/setup-broker-tls.sh once the broker is up to load its cert.
# Using your own broker: point this at its SEMP TLS listener, e.g.
# https://your-broker:1943. Falling back to http://your-broker:8080 works
# too if you don't want TLS on that hop — the exporter doesn't require it.
SOLACE_SEMP_URL=https://host.docker.internal:1943


# CREDENTIALS — change these before any non-local use
# Only used by docker-compose.broker.yaml, to create the admin user.
SOLACE_ADMIN_USER=admin
SOLACE_ADMIN_PASSWORD=admin

# Read-only user the exporter authenticates as. docker-compose.broker.yaml
# creates it automatically. Using your own broker: create a "monitor" user
# with read-only access yourself (see scripts/create-monitor-user.sh).
SOLACE_MONITOR_PASSWORD=monitor_pw

# Grafana login. GOTCHA: fixed in Grafana's DB on first boot — changing this
# later does nothing until you remove the grafana-data volume.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin


# PROMETHEUS RETENTION — bounded both ways so a scrape spike can't fill disk
METRICS_RETENTION_TIME=7d
METRICS_RETENTION_SIZE=2GB


# HOST PORTS — change if something already owns one
PORT_BROKER_SEMP=8080        # docker-compose.broker.yaml only, plaintext
PORT_BROKER_SEMP_TLS=1943    # docker-compose.broker.yaml only, TLS
PORT_BROKER_SMF=55555
PORT_BROKER_HEALTH=5550
PORT_BROKER_SSH=2222
PORT_BROKER_WEB=8008

PORT_EXPORTER=9628
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000


# IMAGE TAGS — pinned deliberately, never :latest
SOLACE_IMAGE=solace/solace-pubsub-standard:10.26.0.8704
EXPORTER_IMAGE=solacecommunity/solace-prometheus-exporter:v1.20.2
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
GRAFANA_IMAGE=grafana/grafana:13.1.1
