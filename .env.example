# =============================================================================
# Solace Distributed Tracing Observatory — configuration
#
# Copy to .env and edit. Every knob in the stack lives here; nothing is
# hardcoded in the YAML files.
#
#   cp .env.example .env
# =============================================================================


# =============================================================================
# BROKER MODE — local container, or your own broker
# =============================================================================
# local    = run a Solace broker as part of this stack (self-contained demo)
# external = use a broker you already have (hosted, VM, another cluster)
#
# stack.sh reads this and enables the right compose profile. If you invoke
# `docker compose` directly instead, set COMPOSE_PROFILES=local-broker yourself
# when running in local mode.
BROKER_MODE=local

# --- Where the broker is -----------------------------------------------------
# local mode:    leave these as-is. `solbroker` is the container's network name.
# external mode: point them at your broker. Use a hostname or IP reachable
#                FROM INSIDE the docker network (not "localhost" — that would
#                resolve to the container itself).
SOLACE_BROKER_HOST=solbroker
SOLACE_BROKER_AMQP_PORT=5672
SOLACE_SEMP_URL=http://solbroker:8080

# Same broker, but as reached from your host machine. Used by `stack.sh verify`
# and the bootstrap script when you run it from a terminal rather than compose.
# local mode:    http://localhost:8080
# external mode: same value as SOLACE_SEMP_URL, usually
SOLACE_SEMP_HOST_URL=http://localhost:8080


# =============================================================================
# MESSAGE VPN
# =============================================================================
# The VPN that gets traced. The bootstrap script creates it, then moves AMQP
# onto it.
#
# WHY THAT MATTERS: a Solace broker binds AMQP port 5672 to exactly ONE Message
# VPN. Out of the box that is `default`. If AMQP stays on `default` while your
# traffic and telemetry profile live here, the collector will connect happily
# and consume nothing at all. This is the single most common failure in this
# stack. The bootstrap script handles it; don't undo it by hand.
SOLACE_MSG_VPN=test

# Spool space for the VPN, in MB. Must be > 0 or the telemetry queue cannot
# store spans and guaranteed messaging will not work.
SOLACE_VPN_SPOOL_MB=1500


# =============================================================================
# CREDENTIALS — change these before any non-local use
# =============================================================================
# Broker admin (SEMP). In local mode these also CREATE the admin user on first
# boot, so changing them later means `stack.sh reset` or changing it on the
# broker too.
SOLACE_ADMIN_USER=admin
SOLACE_ADMIN_PASSWORD=admin

# The identity the OTel Collector uses to bind to the telemetry queue.
# Its ACL profile and client profile must both be named #telemetry-<profile>,
# which the bootstrap script takes care of.
SOLACE_TRACE_USER=trace_user
SOLACE_TRACE_PASSWORD=trace_user_pw

# An ordinary application user, so sdkperf / your own clients can publish and
# subscribe on the traced VPN. Not used by the tracing pipeline itself.
SOLACE_APP_USER=dtuser
SOLACE_APP_PASSWORD=dtuser_pw

# Grafana login.
#
# GOTCHA: with a persistent volume this password is written to Grafana's SQLite
# database on FIRST BOOT and ignored on every start after that. Changing it here
# later does nothing. Reset it with `stack.sh reset`, or through Grafana itself.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin


# =============================================================================
# BROKER BOOTSTRAP
# =============================================================================
# false = skip broker configuration entirely. Use this in external mode when you
#         don't have admin on the broker, or it's already configured.
BOOTSTRAP_ENABLED=true

# Telemetry profile name. The broker derives the queue name from it:
# profile "trace" -> queue "#telemetry-trace". There can be only ONE telemetry
# profile per Message VPN.
TELEMETRY_PROFILE_NAME=trace

# Which topics get traced. ">" is everything.
# Narrow this in production — tracing all topics is expensive at volume.
TRACE_FILTER_SUBSCRIPTION=">"

# Spool space for the telemetry queue itself, in MB. Caps how much a prolonged
# collector outage can consume.
TELEMETRY_QUEUE_SPOOL_MB=500


# =============================================================================
# OTEL COLLECTOR
# =============================================================================
# Full queue address. The queue:// prefix is required by the solace receiver.
SOLACE_TELEMETRY_QUEUE="queue://#telemetry-trace"

# Max in-flight unacknowledged spans before the receiver applies backpressure.
# Tune this before considering a second collector replica — the telemetry queue
# is a single consumption point and scaling past one collector partitions it.
SOLACE_MAX_UNACKNOWLEDGED=500

# memory_limiter — must stay first in the pipeline.
OTEL_MEMORY_LIMIT_MIB=1000
OTEL_MEMORY_SPIKE_MIB=500

# batch — must stay last in the pipeline.
OTEL_BATCH_SIZE=8192
OTEL_BATCH_TIMEOUT=5s

# Collector's own log level: debug | info | warn | error
# info is right for normal use: spans still print (the debug EXPORTER logs at
# info), but without the per-second memory-limiter chatter. Raise to debug only
# when diagnosing the AMQP connection itself — that detail is debug-level.
OTEL_LOG_LEVEL=info

# debug exporter verbosity: basic (count only) | normal (metadata) | detailed (everything)
OTEL_DEBUG_VERBOSITY=normal


# =============================================================================
# JSONL TRACE SINK — off by default
# =============================================================================
# true = also write every span to ./trace-data/traces.jsonl, alongside Tempo.
# Useful for raw dumps, offline inspection and sharing spans. Costs disk.
# stack.sh layers in docker-compose.jsonl.yaml when this is true.
TRACE_FILE_ENABLED=false
TRACE_FILE_MAX_MB=50
TRACE_FILE_MAX_DAYS=90
TRACE_FILE_MAX_BACKUPS=100

# The collector image runs as uid 10001, which cannot write to a host bind mount
# created by your user. Running it as root is the pragmatic local-dev fix.
COLLECTOR_UID=0
COLLECTOR_GID=0


# =============================================================================
# TEMPO
# =============================================================================
# How long traces are kept before compaction discards them. 336h = 14 days.
TEMPO_RETENTION=336h

# How far back `stack.sh verify` searches for traces, in hours. Must comfortably
# exceed the gap between sending traffic and running verify, or a stack left
# idle overnight reports its traces as missing. Keep it under TEMPO_RETENTION.
VERIFY_LOOKBACK_HOURS=168


# =============================================================================
# HOST PORTS — change if something already owns one
# =============================================================================
PORT_BROKER_SEMP=8080       # Broker web UI + SEMP API
PORT_BROKER_SMF=55555       # SMF — this is what sdkperf connects to
PORT_BROKER_AMQP=5672       # AMQP — the collector's path to the telemetry queue
PORT_BROKER_HEALTH=5550     # Health check
PORT_BROKER_SSH=2222        # Broker CLI over SSH
PORT_BROKER_WEB=8008        # Web messaging
PORT_GRAFANA=3000           # Grafana UI
PORT_TEMPO=3200             # Tempo query API
PORT_OTLP_GRPC=4317         # Collector OTLP in — for instrumented apps later
PORT_OTLP_HTTP=4318         # Collector OTLP in — for instrumented apps later
PORT_OTEL_HEALTH=13133      # Collector health check
PORT_OTEL_METRICS=8888      # Collector's own Prometheus metrics
PORT_OTEL_ZPAGES=55679      # Collector zpages — live pipeline diagnostics


# =============================================================================
# IMAGE TAGS — pinned deliberately
# =============================================================================
# Never use :latest here. The collector config schema changes between releases,
# and grafana/tempo:latest is currently a v3.0.0 development build with no
# corresponding release tag.
SOLACE_IMAGE=solace/solace-pubsub-standard:10.26.0.8704
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.144.0
TEMPO_IMAGE=grafana/tempo:2.8.2
GRAFANA_IMAGE=grafana/grafana:13.1.1
CURL_IMAGE=curlimages/curl:8.11.1
