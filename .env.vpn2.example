# =============================================================================
# Overrides for bootstrapping and verifying the SECOND traced Message VPN.
#
#   cp .env.vpn2.example .env.vpn2
#   ENV_FILE=.env.vpn2 ./scripts/setup-broker-tracing.sh
#   ENV_FILE=.env.vpn2 ./scripts/verify.sh
#
# This is not a copy of .env — it sources it and overrides only what differs,
# so the two cannot drift.
#
# Everything not listed here is deliberately identical: the telemetry profile
# name, the trace user and its password, the ACL wiring, the spool sizes. Those
# objects are all scoped to their own Message VPN, so reusing the names across
# VPNs is correct, not a collision.
#
# The collector reads none of this. It only needs SOLACE_BROKER_AMQP_PORT_2,
# which it gets from .env via docker-compose.yaml — the VPN name it reads off
# the spans themselves. One container consumes both VPNs.
# =============================================================================

# shellcheck disable=SC1091
. ./.env

SOLACE_MSG_VPN="${SOLACE_MSG_VPN_2}"
SOLACE_BROKER_AMQP_PORT="${SOLACE_BROKER_AMQP_PORT_2}"
